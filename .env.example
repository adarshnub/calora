# Without complete configuration, development opens an empty setup workspace.
# Production requires complete configuration and owner sign-in.
# Supabase Connect > Transaction pooler (6543), with TLS, for app queries.
# Copy the actual pooler host; percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase Connect > Session pooler (5432), SAME database, for jobs/migrations.
# A reachable direct PostgreSQL connection also works. Do not use port 6543 here.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OWNER_EMAIL=
# Optional: pin the Google subject after your first verified owner login.
OWNER_GOOGLE_SUB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded random 32-byte key. Keep this separate from database backups.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1
