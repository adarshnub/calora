# Add these in Vercel Project Settings > Environment Variables > Production.
# This file is only a template. Replace placeholders and generate your own secrets.
# No variable below should have a NEXT_PUBLIC_ prefix.

# Supabase Connect > Transaction pooler (6543), with TLS, for app queries.
# Copy the actual pooler host; percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase Connect > Session pooler (5432), SAME database, for jobs/migrations.
# A reachable direct PostgreSQL connection also works. Do not use port 6543 here.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# The stable production origin, HTTPS, with no trailing slash.
BETTER_AUTH_URL=https://YOUR_PROJECT.vercel.app
BETTER_AUTH_SECRET=
# Only this verified Google email can sign in to the dashboard.
OWNER_EMAIL=
# Optional hardening after first sign-in. Leave unset initially.
# OWNER_GOOGLE_SUB=

# Google Cloud > Google Auth Platform > Clients > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a SECOND, independent random 32-byte base64 secret for encryption.
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1
